# Docker Environment Configuration
# Copy this to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Pexels Configuration (optional - for Vision Garden stock photos)
PEXELS_API_KEY=your_pexels_api_key_here

# ElevenLabs Configuration (optional - for audio pronunciation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# MongoDB Configuration (for Docker)
MONGODB_URL=mongodb://admin:password@mongodb:27017/wordpecker?authSource=admin

# Backend Configuration
PORT=3100
NODE_ENV=development
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=langsift_session
SESSION_DAYS=30

# Frontend Configuration
VITE_API_URL=http://localhost:3100
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
